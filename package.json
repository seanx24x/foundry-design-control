{
  "name": "foundry-design-control",
  "private": true,
  "version": "0.2.0-beta.22",
  "description": "Local-first visual design control plane for coding agents",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:sync": "node scripts/sync-release-version.mjs",
    "release:artifact-contract": "node --test scripts/release-artifacts.test.mjs scripts/cursor-install-link.test.mjs",
    "release:trust-check": "node scripts/trusted-publisher-check.mjs",
    "release:trust-contract": "node scripts/trusted-publisher-check.mjs --contract-only",
    "readme:sync": "node scripts/sync-package-readmes.mjs",
    "foundry": "node packages/cli/dist/index.js",
    "release:check": "node scripts/sync-package-readmes.mjs && pnpm release:artifact-contract && node scripts/release-check.mjs && node scripts/release-safety-check.mjs && pnpm release:trust-contract",
    "distribution:check": "node scripts/distribution-check.mjs",
    "openai:submission": "node scripts/build-openai-submission.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:verify-public": "node scripts/verify-public-release.mjs",
    "release:tag-beta": "node scripts/promote-release.mjs --tag=beta",
    "release:promote": "node scripts/promote-release.mjs",
    "release:test-install": "node scripts/test-packed-install.mjs",
    "test:golden:packed": "node scripts/test-real-golden-path.mjs --mode packed",
    "test:golden:negative": "node scripts/test-real-golden-path.mjs --mode packed --negative all",
    "test:golden:registry": "node scripts/test-real-golden-path.mjs --mode registry",
    "test:e2e": "pnpm build && node scripts/test-workspace-playwright.mjs",
    "mcpb:build": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
